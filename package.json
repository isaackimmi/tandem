{
  "name": "tandem",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/run.mjs",
    "start": "node scripts/run.mjs --production",
    "build": "npm --prefix client run build",
    "typecheck": "npm --prefix client run typecheck",
    "test:backend": "server/.venv/bin/python -m pytest server/tests -q",
    "test:e2e": "node scripts/e2e.mjs",
    "videos": "node scripts/videos.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "ffmpeg-static": "5.3.0"
  },
  "engines": { "node": ">=22" }
}
